# Copy to .env and fill in. .env is gitignored; this template is not.
#
# SEC EDGAR fair-access User-Agent, format "AppName ContactEmail".
# SEC requires a real contact address on every request; edgar_pull.py warns if the
# placeholder below is still in use. NOTE: the filing pull is not to be re-run, so this
# is needed only if you deliberately extend the corpus.
EDGAR_USER_AGENT=TariffFactorResearch your-email@example.com

# WRDS credentials are NOT used by this pipeline. Every WRDS extract (CRSP, Compustat,
# CCM, Ken French) is a static CSV exported by hand and read from the repository root, so
# no script authenticates against WRDS. Uncomment only if you add a programmatic pull.
# WRDS_USERNAME=
# WRDS_PASSWORD=
