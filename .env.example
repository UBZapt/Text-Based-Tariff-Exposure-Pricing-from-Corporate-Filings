# Copy to .env and fill in. .env is gitignored; this template is not.
#
# SEC EDGAR fair-access User-Agent, format "AppName ContactEmail". SEC requires a real contact
# address on every request; edgar_pull.py warns if the placeholder below is still in use.
# Only the filing download (src/edgar_pull.py) reads it.
EDGAR_USER_AGENT=TariffFactorResearch your-email@example.com
